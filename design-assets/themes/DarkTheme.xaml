<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 
    ClawStatus Dark Theme - 专业银灰
    风格：银灰金属质感 + 蓝色发光效果
    参考：机械龙虾设计图 6.png
    -->
    
    <!-- 主色调定义 -->
    <Color x:Key="PrimaryColor">#2C2C2C</Color>
    <Color x:Key="SecondaryColor">#3D3D3D</Color>
    <Color x:Key="AccentColor">#5A5A5A</Color>
    
    <!-- 发光效果颜色 -->
    <Color x:Key="GlowColor">#4A90E2</Color>
    <Color x:Key="GlowIdleColor">#4A90E2</Color>
    <Color x:Key="GlowBusyColor">#FFA500</Color>
    <Color x:Key="GlowFireColor">#FF0000</Color>
    <Color x:Key="GlowErrorColor">#FF0000</Color>
    <Color x:Key="GlowOfflineColor">#3A3A3A</Color>
    
    <!-- 字体颜色 -->
    <Color x:Key="TextColor">#E0E0E0</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
    
    <!-- 背景颜色 -->
    <Color x:Key="BackgroundColor">#1A1A1A</Color>
    <Color x:Key="WindowBackgroundColor">#00000000</Color>
    
    <!-- 金属质感渐变 -->
    <LinearGradientBrush x:Key="MetalGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C2C2C" Offset="0.0"/>
        <GradientStop Color="#3D3D3D" Offset="0.5"/>
        <GradientStop Color="#2C2C2C" Offset="1.0"/>
    </LinearGradientBrush>
    
    <!-- 发光效果画笔 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="GlowBrush" Color="{StaticResource GlowColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    
    <!-- 状态颜色 -->
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource GlowIdleColor}"/>
    <SolidColorBrush x:Key="BusyBrush" Color="{StaticResource GlowBusyColor}"/>
    <SolidColorBrush x:Key="FireBrush" Color="{StaticResource GlowFireColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource GlowErrorColor}"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="{StaticResource GlowOfflineColor}"/>
    
    <!-- 发光效果（带模糊） -->
    <DropShadowEffect x:Key="GlowEffect" 
                      BlurRadius="15" 
                      ShadowDepth="0" 
                      Color="{StaticResource GlowColor}"
                      Opacity="0.8"/>
    
    <!-- 字体定义 -->
    <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    
    <!-- 字号 -->
    <sys:Double x:Key="FontSizeSmall">10</sys:Double>
    <sys:Double x:Key="FontSizeNormal">12</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    
    <!-- 动画时长 -->
    <Duration x:Key="AnimationDuration">00:00:00.300</Duration>
    <Duration x:Key="BlinkDuration">00:00:00.100</Duration>
</ResourceDictionary>
